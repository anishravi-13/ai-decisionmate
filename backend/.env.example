# AI DecisionMate — Environment Variables
# Copy this file to .env and fill in any optional API keys.
# The application runs fully without any API keys (uses local fallbacks).

# Optional: Google Maps Places API key for live nearby business search
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: SerpAPI key for live product search
# SERP_API_KEY=your_serp_api_key_here

# Database (default: local SQLite, no setup needed)
# DATABASE_URL=sqlite:///./decisionmate.db
